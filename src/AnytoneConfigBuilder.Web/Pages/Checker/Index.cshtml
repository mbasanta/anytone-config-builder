@page
@model AnytoneConfigBuilder.Web.Pages.Checker.IndexModel
@{
    ViewData["Title"] = "Channel Checker";
}

<style>
    .form-text-help {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: #6c757d;
    }
</style>

<div class="mb-4">
    <h1 class="display-6">Channel Checker</h1>
    <p class="text-muted">Upload a channels.csv file to run consistency checks on your configuration.</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i> @Html.Raw(Model.ErrorMessage)
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle"></i> @Model.InfoMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" enctype="multipart/form-data" class="card p-3 mb-4">
    <div class="mb-3">
        <label class="form-label" for="channels">
            <i class="bi bi-file-earmark"></i> channels.csv
        </label>
        <input class="form-control" type="file" id="channels" name="channels" accept=".csv" required />
        <small class="form-text-help">Upload the channels.csv file exported from Anytone CPS to check for consistency issues.</small>
    </div>

    <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
        <i class="bi bi-check-circle"></i> Run Checker
    </button>
</form>

@if (!string.IsNullOrWhiteSpace(Model.ReportHtml))
{
    <div class="card">
        <div class="card-header bg-light">
            <strong>Channel Consistency Report</strong>
        </div>
        <div class="card-body">
            @Html.Raw(Model.ReportHtml)
        </div>
    </div>
}

<div class="mt-4">
    <a asp-page="/Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Builder
    </a>
</div>

<script>
    document.querySelector('form').addEventListener('submit', function() {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Checking...';
    });
</script>
